<script>
	// Not yet in the bundled DOM typings.
	type ViewTransitionDocument = Document & {
		startViewTransition?: (update: () => void) => { ready: Promise<void>; finished: Promise<void> };
	};

	class ThemeToggle extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector("button") as HTMLButtonElement;

			function setTheme(dark: boolean) {
				document.documentElement.classList.toggle("dark", dark);
				// set the aria-pressed attribute, dark mode === aria-pressed=true
				button.setAttribute("aria-pressed", String(dark));
			}

			button.addEventListener("click", () => {
				const next = !this.isDark();
				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

				// Where supported, the new theme spreads out from the button like ink.
				const doc = document as ViewTransitionDocument;
				if (!doc.startViewTransition || reduceMotion) {
					setTheme(next);
					return;
				}

				const rect = button.getBoundingClientRect();
				const x = rect.left + rect.width / 2;
				const y = rect.top + rect.height / 2;
				const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

				document.documentElement.dataset.themeSwitch = "";
				const transition = doc.startViewTransition(() => setTheme(next));
				transition.ready.then(() => {
					document.documentElement.animate(
						{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
						{ duration: 650, easing: "cubic-bezier(.65,0,.35,1)", pseudoElement: "::view-transition-new(root)" }
					);
				});
				transition.finished.finally(() => delete document.documentElement.dataset.themeSwitch);
			});

			// Initalise button state
			setTheme(this.isDark());
		}

		// returns if the root element contains the dark class
		isDark() {
			return document.documentElement.classList.contains("dark");
		}
	}

	customElements.define("theme-toggle", ThemeToggle);
</script>

<theme-toggle>
	<button
		type="button"
		id="toggle-theme"
		class="group relative grid h-8 w-8 place-items-center overflow-hidden rounded-md border border-line bg-elev text-ink-soft transition-colors hover:border-accent hover:text-accent"
		aria-label="Toggle dark mode"
	>
		<!-- Sun: shown in dark mode -->
		<svg
			class="absolute h-[18px] w-[18px] translate-y-6 rotate-90 opacity-0 transition-all duration-500 group-aria-pressed:translate-y-0 group-aria-pressed:rotate-0 group-aria-pressed:opacity-100"
			aria-hidden="true"
			focusable="false"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
		>
			<circle cx="12" cy="12" r="4.2"></circle>
			<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
		</svg>
		<!-- Moon: shown in light mode -->
		<svg
			class="absolute h-[18px] w-[18px] translate-y-0 rotate-0 opacity-100 transition-all duration-500 group-aria-pressed:-translate-y-6 group-aria-pressed:-rotate-90 group-aria-pressed:opacity-0"
			aria-hidden="true"
			focusable="false"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
		</svg>
	</button>
</theme-toggle>

<style is:global>
	/* The circular reveal replaces the default cross-fade for theme switches only. */
	:root[data-theme-switch]::view-transition-old(root),
	:root[data-theme-switch]::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}
</style>
