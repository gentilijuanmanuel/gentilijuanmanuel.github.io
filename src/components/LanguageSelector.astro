---
interface Props {
	currentLanguage: string;
}

const { currentLanguage } = Astro.props;
---

<div class="language-selector inline-flex rounded-md border border-line bg-elev p-0.5 font-mono text-[0.6875rem]" role="group" aria-label="Language">
	<button
		type="button"
		class:list={["language-btn", { active: currentLanguage === "en" }]}
		data-language="en"
		aria-label="English"
	>
		EN
	</button>
	<button
		type="button"
		class:list={["language-btn", { active: currentLanguage === "es" }]}
		data-language="es"
		aria-label="Spanish"
	>
		ES
	</button>
</div>

<style>
	.language-btn {
		cursor: pointer;
		border-radius: 0.3rem;
		padding: 0.3rem 0.65rem;
		letter-spacing: 0.08em;
		color: var(--theme-muted);
		transition: color 0.2s ease, background-color 0.2s ease;
	}

	.language-btn:hover {
		color: var(--theme-ink);
	}

	.language-btn.active {
		color: var(--theme-bg);
		background-color: var(--theme-accent);
	}
</style>

<script>
	const buttons = document.querySelectorAll(".language-btn");

	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			const language = button.getAttribute("data-language");
			if (language) {
				localStorage.setItem("preferredLanguage", language);

				// Remove active class from all buttons
				buttons.forEach((btn) => btn.classList.remove("active"));
				// Add active class to clicked button
				button.classList.add("active");

				// Dispatch event for other components to listen to
				window.dispatchEvent(new CustomEvent("languageChange", { detail: { language } }));
			}
		});
	});
</script>
