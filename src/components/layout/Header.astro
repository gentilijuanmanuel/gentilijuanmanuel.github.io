---
import ThemeToggle from "../ThemeToggle.astro";
import { MENU_LINKS } from "@/data/constants";

const url = new URL(Astro.request.url);
const segments = url.pathname.split("/").filter(Boolean);
// A shell-style breadcrumb of where the reader is: ~/posts/oasis
const crumb = segments.length ? `~/${segments.join("/")}` : "~";

const isActive = (path: string) =>
	path === "/" ? url.pathname === "/" : url.pathname.startsWith(path);
---

<header
	id="main-header"
	class="sticky top-0 z-40 border-b border-transparent bg-[--theme-header-bg] backdrop-blur-md transition-[border-color] duration-300 data-[scrolled=true]:border-line"
	data-scrolled="false"
>
	<div class="mx-auto flex h-16 max-w-5xl items-center gap-3 px-5 sm:px-8">
		<a href="/" class="group flex min-w-0 items-center gap-3" aria-current={url.pathname === "/" ? "page" : false}>
			<span class="flex min-w-0 flex-col leading-tight">
				<span class="font-serif text-[1.05rem] font-medium tracking-tight text-ink transition-colors group-hover:text-accent"><span class="sm:hidden">Juan</span><span class="hidden sm:inline">Juan Manuel Gentili</span></span>
				<span class="hidden truncate font-mono text-[0.6875rem] text-muted sm:block">
					<span class="text-accent">❯</span>
					{crumb}
				</span>
			</span>
		</a>

		<nav aria-label="Main menu" class="ms-auto flex items-center font-mono text-[0.8125rem]">
			{
				MENU_LINKS.map((link) => (
					<a
						href={link.path}
						rel="prefetch"
						aria-current={isActive(link.path) ? "page" : false}
						class="group relative px-2.5 py-2 text-ink-soft transition-colors hover:text-ink aria-[current=page]:text-ink sm:px-3"
					>
						<span class="text-accent opacity-0 transition-opacity group-hover:opacity-100 group-aria-[current=page]:opacity-100">
							/
						</span>
						{link.title.toLowerCase()}
					</a>
				))
			}
		</nav>

		<button
			type="button"
			data-open-palette
			class="kbd hidden h-8 cursor-pointer px-2 transition-colors hover:border-accent hover:text-ink md:inline-flex"
			aria-label="Open command palette"
		>
			<span aria-hidden="true">⌘K</span>
		</button>
		<ThemeToggle />
	</div>
</header>

<script>
	const header = document.getElementById("main-header");
	if (header) {
		const update = () => (header.dataset.scrolled = String(window.scrollY > 8));
		update();
		window.addEventListener("scroll", update, { passive: true });
	}
</script>
