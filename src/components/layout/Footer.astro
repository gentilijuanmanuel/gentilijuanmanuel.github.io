---
import { MENU_LINKS } from "@/data/constants";
import SocialList from "@/components/SocialList";

const year = new Date().getFullYear();
// The homepage hero already lists the social links.
const showSocial = new URL(Astro.request.url).pathname !== "/";
---

<footer class="mt-auto border-t border-line">
	<div class="mx-auto flex max-w-5xl flex-col px-5 sm:px-8">
		{
			showSocial && (
				<div class="-ms-2.5 border-b border-dashed border-line py-4">
					<SocialList />
				</div>
			)
		}
		<!-- A status bar, like the bottom of an editor window. -->
		<div
			class="flex flex-col gap-3 py-5 font-mono text-[0.6875rem] text-muted sm:flex-row sm:items-center sm:justify-between"
		>
			<div class="flex items-center gap-2">
				<span class="relative flex h-2 w-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal opacity-60"></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-signal"></span>
				</span>
				<span>© {year} Juan Manuel Gentili</span>
				<span aria-hidden="true">·</span>
				<span>Argentina</span>
			</div>
			<nav aria-label="More on this site" class="flex flex-wrap items-center gap-x-4 gap-y-2">
				{
					MENU_LINKS.map((link) => (
						<a href={link.path} class="transition-colors hover:text-accent">
							{link.title.toLowerCase()}
						</a>
					))
				}
				<a href="/tags" class="transition-colors hover:text-accent">tags</a>
				<a href="/rss.xml" class="transition-colors hover:text-accent">rss</a>
			</nav>
		</div>
	</div>
</footer>
