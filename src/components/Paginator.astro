---
import type { PaginationLink } from "@/data/shared";

interface Props {
	prevUrl?: PaginationLink;
	nextUrl?: PaginationLink;
}

const { prevUrl, nextUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="mt-10 flex items-center gap-x-4 font-mono text-xs">
			{prevUrl && (
				<a class="me-auto rounded-md border border-line px-3 py-2 text-ink-soft transition-colors hover:border-accent hover:text-accent" href={prevUrl.url} rel="prefetch">
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text ? prevUrl.text : "Previous"}
				</a>
			)}
			{nextUrl && (
				<a class="ms-auto rounded-md border border-line px-3 py-2 text-ink-soft transition-colors hover:border-accent hover:text-accent" href={nextUrl.url} rel="prefetch">
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text ? nextUrl.text : "Next"}
				</a>
			)}
		</nav>
	)
}
