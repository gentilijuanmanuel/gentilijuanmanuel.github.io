---
import type { CollectionEntry } from "astro:content";

import BaseLayout from "./Base.astro";
import BlogHero from "@/components/blog/Hero";
import MonetizationButtons from "@/components/MonetizationButtons";
import LanguageSelector from "@/components/LanguageSelector";

interface Props {
	post: CollectionEntry<"post">;
	translatedPost: CollectionEntry<"post"> | undefined;
}

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

const { post, translatedPost } = Astro.props;
const {
	data: { title, description, ogImage, publishDate, language },
	slug,
} = post;
// Link previews show the post's first image (HTML or Markdown), unless the
// frontmatter picks one. Posts without images fall back to the site's card.
const firstImage = post.body.match(/<img[^>]*?\ssrc="([^"]+)"|!\[[^\]]*\]\(([^)\s]+)/);
const socialImage = ogImage ?? firstImage?.[1] ?? firstImage?.[2];
const articleDate = publishDate.toISOString();
const { headings } = await post.render();
const outline = headings.filter(({ depth }) => depth <= 3);

const WORDS_PER_MINUTE = 220;
const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE));

// Get the current language from localStorage or default to post's language
const currentLanguage = language;
const hasAnalytics = Boolean(import.meta.env.PUBLIC_GA_MEASUREMENT_ID);
---

<script define:vars={{ currentLanguage, slug, translatedPost, language }}>
	// Initialize language from localStorage or default to post's language
	const savedLanguage = localStorage.getItem('preferredLanguage') || currentLanguage;
	document.documentElement.lang = savedLanguage;
	
	// Update language when changed
	window.addEventListener('languageChange', (event => {
		const newLanguage = event.detail.language;
		console.log('Language change event received:', { newLanguage, currentLanguage, translatedPost });
		document.documentElement.lang = newLanguage;
		
		// If we have a translated post and the language is different from current post,
		// redirect to the translated post
		if (translatedPost && newLanguage !== language) {
			console.log('Redirecting to translated post:', translatedPost.slug);
			window.location.href = `/posts/${translatedPost.slug}`;
		} else if (!translatedPost && newLanguage === language) {
			console.log('Redirecting to current post:', slug);
			window.location.href = `/posts/${slug}`;
		} else {
			// If no translation is available, just update the language
			console.log('No translation available, updating language only');
			document.documentElement.lang = newLanguage;
		}
	}));

	// Initialize scroll to top button, reading progress and the outline's active section
	document.addEventListener('DOMContentLoaded', () => {
		const progress = document.getElementById("reading-progress");
		const article = document.getElementById("post-body");
		if (progress && article) {
			let frame = 0;
			const update = () => {
				frame = 0;
				const rect = article.getBoundingClientRect();
				const total = Math.max(rect.height - window.innerHeight, 1);
				const ratio = Math.min(Math.max(-rect.top / total, 0), 1);
				progress.style.transform = `scaleX(${ratio})`;
			};
			const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
			update();
			window.addEventListener("scroll", schedule, { passive: true });
			window.addEventListener("resize", schedule, { passive: true });
		}

		const outlineLinks = Array.from(document.querySelectorAll("[data-outline-link]"));
		if (outlineLinks.length && article) {
			const headingEls = outlineLinks
				.map((link) => document.getElementById(link.dataset.outlineLink))
				.filter(Boolean);
			const setActive = (id) => {
				outlineLinks.forEach((link) => {
					link.dataset.active = String(link.dataset.outlineLink === id);
				});
			};
			const headingObserver = new IntersectionObserver((entries) => {
				// The active section is the last heading that has scrolled above the reading line.
				const line = window.innerHeight * 0.3;
				let current = headingEls[0]?.id;
				headingEls.forEach((el) => {
					if (el.getBoundingClientRect().top - line <= 0) current = el.id;
				});
				setActive(current);
			}, { rootMargin: "0px 0px -70% 0px", threshold: [0, 1] });
			headingEls.forEach((el) => headingObserver.observe(el));
		}

		const scrollBtn = document.getElementById("to-top-btn");
		const targetHeader = document.getElementById("blog-hero");

		if (scrollBtn && targetHeader) {
			function callback(entries) {
				entries.forEach((entry) => {
					// only show the scroll to top button when the heading is out of view
					scrollBtn.dataset.show = (!entry.isIntersecting).toString();
				});
			}

			scrollBtn.addEventListener("click", () => {
				document.documentElement.scrollTo({ top: 0, behavior: "smooth" });
			});

			const observer = new IntersectionObserver(callback);
			observer.observe(targetHeader);
		}
	});
</script>

<script is:inline define:vars={{ slug, title, language, hasAnalytics }}>
	if (!hasAnalytics) {
		// Analytics not configured.
	} else {
		const VIEW_SECONDS = 5;
		const READ_SECONDS = 30;
		const READ_SCROLL_RATIO = 0.25;
		const IDLE_THRESHOLD_MS = 15000;
		const TICK_MS = 1000;

		let engagedMs = 0;
		let firedView = false;
		let firedRead = false;
		let maxScrollRatio = 0;
		let lastTick = performance.now();
		let lastInteraction = performance.now();
		let isVisible = !document.hidden;
		const trackingEnv =
			window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1"
				? "local"
				: "prod";

		function sendEvent(name) {
			if (typeof window.gtag !== "function") return;
			window.gtag("event", name, {
				post_slug: slug,
				post_title: title,
				post_language: language,
				tracking_env: trackingEnv,
			});
		}

		function recordInteraction() {
			lastInteraction = performance.now();
		}

		function updateScrollRatio() {
			const doc = document.scrollingElement || document.documentElement || document.body;
			if (!doc) return;
			const scrollTop = doc.scrollTop || 0;
			const scrollHeight = doc.scrollHeight || 0;
			const clientHeight = doc.clientHeight || window.innerHeight || 0;
			const maxScrollable = Math.max(scrollHeight - clientHeight, 1);
			const ratio = scrollTop / maxScrollable;
			if (ratio > maxScrollRatio) maxScrollRatio = ratio;
		}

		window.addEventListener("scroll", () => {
			recordInteraction();
			updateScrollRatio();
		}, { passive: true });

		["mousemove", "keydown", "touchstart", "touchmove"].forEach((eventName) => {
			window.addEventListener(eventName, recordInteraction, { passive: true });
		});

		document.addEventListener("visibilitychange", () => {
			isVisible = !document.hidden;
			if (isVisible) {
				lastInteraction = performance.now();
				updateScrollRatio();
			}
		});

		updateScrollRatio();

		setInterval(() => {
			const now = performance.now();
			const elapsed = now - lastTick;
			lastTick = now;

			if (!isVisible) return;
			if (now - lastInteraction > IDLE_THRESHOLD_MS) return;

			engagedMs += elapsed;

			if (!firedView && engagedMs >= VIEW_SECONDS * 1000) {
				firedView = true;
				sendEvent("post_view");
			}

			if (!firedRead && engagedMs >= READ_SECONDS * 1000 && maxScrollRatio >= READ_SCROLL_RATIO) {
				firedRead = true;
				sendEvent("post_read");
			}
		}, TICK_MS);
	}
</script>

<BaseLayout meta={{ title, description, articleDate, ogImage: socialImage }} wide>
	<div
		id="reading-progress"
		class="pointer-events-none fixed inset-x-0 top-0 z-50 h-[2px] origin-left scale-x-0 bg-accent shadow-[0_0_12px_var(--theme-glow)]"
		aria-hidden="true"
	>
	</div>
	<div class="gap-x-16 lg:grid lg:grid-cols-[minmax(0,1fr)_14rem]">
		<article class="mx-auto w-full max-w-measure break-words lg:mx-0">
			<div id="blog-hero">
				<div class="mb-10 flex items-center justify-between gap-4">
					<a href="/posts" class="group font-mono text-xs text-muted transition-colors hover:text-accent">
						<span class="inline-block transition-transform group-hover:-translate-x-1">←</span> all posts
					</a>
					<LanguageSelector currentLanguage={currentLanguage} />
				</div>
				<BlogHero content={post} readingMinutes={readingMinutes} />
			</div>
			<div class="reveal mt-12 flex items-center gap-4 text-accent" style="--i:3" aria-hidden="true">
				<span class="h-px flex-1 bg-line"></span>
				<span class="font-mono text-xs">✦</span>
				<span class="h-px flex-1 bg-line"></span>
			</div>
			<div id="post-body" class="post-prose prose prose-ink mt-12 max-w-none">
				<slot />
			</div>
			<div
				class="mt-20 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-line bg-elev px-4 py-3 font-mono text-[0.6875rem] text-muted"
			>
				<span>{wordCount.toLocaleString("en-US")} words · {readingMinutes} min</span>
				<span class="flex items-center gap-4">
					{translatedPost && (
						<a href={`/posts/${translatedPost.slug}`} class="transition-colors hover:text-accent">
							{translatedPost.data.language === "es" ? "leer en español" : "read in english"}
						</a>
					)}
					<span><span class="text-accent">EOF</span> thanks for reading</span>
				</span>
			</div>
			<div class="mt-10 lg:hidden">
				<MonetizationButtons />
			</div>
		</article>
		{
			!!outline.length && (
				<aside class="hidden lg:block">
					<div class="sticky top-28">
						<div class="flex gap-5 border-b border-line font-mono text-xs">
							<span class="-mb-px border-b-2 border-accent pb-2 text-ink">Outline</span>
						</div>
						<ol class="mt-4 space-y-0.5 border-s border-line font-mono text-[0.75rem]">
							{outline.map(({ depth, slug, text }: Heading) => (
								<li>
									<a
										data-outline-link={slug}
										data-active="false"
										class={`-ms-px block border-s-2 border-transparent py-1.5 pe-2 leading-snug text-muted transition-colors hover:text-ink data-[active=true]:border-accent data-[active=true]:text-ink ${depth <= 2 ? "ps-3" : "ps-6 text-[0.6875rem]"}`}
										href={`#${slug}`}
										aria-label={`Scroll to section: ${text}`}
									>
										<span class="line-clamp-2">{text}</span>
									</a>
								</li>
							))}
						</ol>
						<div class="mt-10">
							<MonetizationButtons />
						</div>
					</div>
				</aside>
			)
		}
	</div>
	<button
		id="to-top-btn"
		class="fixed bottom-6 end-5 z-40 flex h-11 w-11 translate-y-24 items-center justify-center rounded-full border border-line bg-elev text-ink-soft opacity-0 shadow-lg transition-all duration-300 hover:border-accent hover:text-accent data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8"
		aria-label="Back to Top"
		data-show="false"
		><svg
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
			focusable="false"
			fill="none"
			viewBox="0 0 24 24"
			stroke-width="1.6"
			stroke="currentColor"
			class="h-5 w-5"
		>
			<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
		</svg>
	</button>
</BaseLayout>

<style is:global>
	/* Editor-style heading markers, like a markdown buffer. */
	.post-prose h2::before,
	.post-prose h3::before {
		font-family: var(--font-mono);
		font-size: 0.7em;
		font-weight: 400;
		color: var(--theme-accent);
		margin-inline-end: 0.5em;
		vertical-align: 0.1em;
	}
	.post-prose h2::before {
		content: "#";
	}
	.post-prose h3::before {
		content: "##";
	}

	/* A drop cap on the opening paragraph, set like a printed book. */
	.post-prose > p:first-of-type::first-letter {
		float: left;
		font-family: var(--font-serif);
		font-size: 4.1em;
		line-height: 0.82;
		font-weight: 500;
		padding: 0.08em 0.1em 0 0;
		color: var(--theme-accent);
	}
</style>
