---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import PostPreview from "@/components/blog/PostPreview";
import SocialList from "@/components/SocialList";
import ReadingHighlights from "@/components/ReadingHighlights";
import { sortMDByDate } from "@/utils";
import { READING_LINKS, SOCIAL_LINKS, WORK_EXPERIENCE, WORK_LINKS } from "@/data/constants";
import { siteConfig } from "@/site-config";

const MAX_POSTS = 100;
const allPosts = await getCollection("post");
const englishPosts = allPosts.filter((post) => post.data.language === "en");

const allPostsByDate = sortMDByDate(englishPosts).slice(0, MAX_POSTS);
---

<PageLayout meta={{ title: "Home" }}>
	<section class="relative">
		<h1 class="sr-only">{siteConfig.title}</h1>
		<p
			class="reveal font-serif text-[2.6rem] font-light leading-[1.05] tracking-tight text-ink sm:text-6xl"
			style="--i:1"
		>
			A human who writes in <span
				class="font-typewriter text-[0.86em] font-normal tracking-tight text-accent">natural</span
			>
			and <span class="glitch font-mono text-[0.78em] font-normal tracking-tighter"
				>programming</span
			>
			languages<span class="caret" aria-hidden="true"></span>
		</p>

		<div
			class="reveal mt-10 max-w-xl space-y-4 text-lg leading-relaxed text-ink-soft"
			style="--i:2"
		>
			<p>
				Currently living in Argentina and working as an iOS/watchOS engineer at
				<a
					class="ink-link text-ink"
					href={WORK_LINKS.runna}
					target="_blank"
					rel="noopener noreferrer">Runna</a
				>
				(acquired by <a
					class="ink-link text-ink"
					href={WORK_LINKS.strava}
					target="_blank"
					rel="noopener noreferrer">Strava</a
				>).
			</p>
			<p>
				This is my little corner of the internet. My tiny garden. I write about whatever inspires or
				interests me, usually in the form of blog posts.
			</p>
		</div>

		<div class="reveal -ms-2.5 mt-6" style="--i:3">
			<SocialList />
		</div>

		<figure class="paper-page reveal mt-14 px-7 pb-7 pt-9 sm:px-12 sm:pb-9 sm:pt-12" style="--i:4">
			<blockquote>
				<p class="paper-text text-[1.35rem] leading-[1.45] sm:text-[1.6rem]">
					Life isn't about finding yourself, or finding anything. Life is about creating yourself.
					And creating things.
				</p>
			</blockquote>
			<figcaption
				class="mt-6 flex items-center justify-between font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-[--card-muted]"
			>
				<span>— Bob Dylan</span>
				<span aria-hidden="true">p. 1</span>
			</figcaption>
		</figure>
	</section>

	<section aria-labelledby="writing-heading" class="mt-28">
		<header class="mb-6 flex items-end justify-between gap-4 border-b border-line pb-4">
			<div>
				<p class="eyebrow">§ 01</p>
				<h2 id="writing-heading" class="title mt-2">Writing</h2>
			</div>
			<a href="/posts" class="font-mono text-xs text-muted transition-colors hover:text-accent"
				>all posts →</a
			>
		</header>
		<ul>
			{
				allPostsByDate.map((p, index) => (
					<li
						class="reveal border-b border-dashed border-line last:border-b-0"
						style={`--i:${Math.min(index, 10) + 5}`}
					>
						<PostPreview post={p} index={index} as="h3" />
					</li>
				))
			}
		</ul>
	</section>

	<section aria-labelledby="work-heading" class="mt-28">
		<header class="mb-6 flex items-end justify-between gap-4 border-b border-line pb-4">
			<div>
				<p class="eyebrow">§ 02</p>
				<h2 id="work-heading" class="title mt-2">Work</h2>
			</div>
			<a
				href={SOCIAL_LINKS.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="font-mono text-xs text-muted transition-colors hover:text-accent">linkedin →</a
			>
		</header>
		<ol class="relative">
			{
				WORK_EXPERIENCE.map((job) => (
					<li class="group grid gap-x-6 gap-y-1 border-b border-dashed border-line py-5 last:border-b-0 sm:grid-cols-[8.5rem_minmax(0,1fr)]">
						<p class="flex items-center gap-2 self-start font-mono text-[0.75rem] text-muted sm:pt-1.5">
							{!job.end && (
								<span class="relative flex h-1.5 w-1.5" aria-hidden="true">
									<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60" />
									<span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent" />
								</span>
							)}
							<span>
								{job.start.split(" ")[1]} → {job.end ? job.end.split(" ")[1] : "now"}
							</span>
						</p>
						<div class="min-w-0">
							<h3 class="font-serif text-[1.1875rem] leading-snug text-ink sm:text-xl">
								{job.role}
								<span class="text-muted"> · </span>
								{job.url ? (
									<a class="ink-link" href={job.url} target="_blank" rel="noopener noreferrer">
										{job.company}
									</a>
								) : (
									<span>{job.company}</span>
								)}
							</h3>
							<p class="mt-1 font-serif text-base italic leading-relaxed text-ink-soft">
								{job.summary}
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section aria-labelledby="reading-heading" class="mt-28">
		<header class="mb-6 border-b border-line pb-4">
			<p class="eyebrow">§ 03</p>
			<h2 id="reading-heading" class="title mt-2">Reading</h2>
		</header>
		<p class="max-w-xl text-lg leading-relaxed text-ink-soft">
			Pages torn from whatever I'm reading. All my highlights are collected on my Readwise account,
			and you can get them in your inbox by joining
			<a
				class="ink-link text-ink"
				href={READING_LINKS.readwise}
				target="_blank"
				rel="noopener noreferrer">my newsletter</a
			>.
		</p>
		<ReadingHighlights />
	</section>
</PageLayout>
