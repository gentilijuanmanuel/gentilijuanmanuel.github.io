---
import PageLayout from "@/layouts/Base";
import BookCover from "@/components/library/BookCover";
import { getLibrary, hashOf, readingPeriod, shelvesBySubject } from "@/utils/library";
import { SOCIAL_LINKS } from "@/data/constants";

const library = await getLibrary();
const shelves = shelvesBySubject(library);

const totalHighlights = library.reduce((sum, book) => sum + book.highlightCount, 0);
const firstYear = Math.min(...library.map((book) => book.firstRead.getFullYear()));

const meta = {
	title: "Library",
	description:
		"Every book I've read and highlighted, shelved by subject, with the passages I marked.",
};

// Thicker books for more highlights, on a square-root curve so a 200-highlight
// book doesn't dwarf the shelf. Heights vary per book, like a real shelf.
const spineWidth = (count: number) =>
	Math.min(58, Math.max(28, Math.round(24 + Math.sqrt(count) * 2.6)));
const spineHeight = (slug: string) => 228 + (hashOf(slug) % 6) * 8;

// A spine has room for a surname, not a full name. "Baid, Gautam" is already
// surname first, and a regnal name like "Leo XIV" only makes sense whole.
const spineAuthor = (author: string | null) => {
	if (!author) return "";
	if (author.includes(",")) return author.split(",")[0]!.trim();
	const words = author.split(" ");
	const last = words[words.length - 1] ?? author;
	return /^[IVXLC]+$/.test(last) ? author : last;
};

// Short enough for the preview pane, cut on a word.
const snippet = (text: string, max = 220) =>
	text.length <= max ? text : `${text.slice(0, text.lastIndexOf(" ", max))}…`;

let spineIndex = 0;
---

<PageLayout meta={meta} wide>
	<header class="mb-12 max-w-2xl">
		<p class="reveal eyebrow" style="--i:0"><span class="text-accent">//</span> the library</p>
		<h1 class="reveal title mt-3" style="--i:1">Library</h1>
		<p class="reveal mt-6 text-lg leading-relaxed text-ink-soft" style="--i:2">
			Since 2023, I've used Readwise to keep track of the books I read and highlight. This list
			shows them, fiction and non-fiction. At some point in my life, I'll probably add the physical
			books I read before software and digitalization ate the world. It will be a nice, nostalgic
			trip back to my youth.
		</p>
		<p class="reveal mt-4 text-lg leading-relaxed text-ink-soft" style="--i:2">
			Each book shows a portion of my highlights, up to about a thousand words.
		</p>
		{
			library.length > 0 && (
				<p class="reveal mt-5 font-mono text-[0.75rem] text-muted" style="--i:3">
					{library.length} books <span class="text-accent">◆</span>{" "}
					{totalHighlights.toLocaleString("en-US")} highlights <span class="text-accent">◆</span>{" "}
					{firstYear} → now <span class="text-accent">◆</span>{" "}
					<a
						class="transition-colors hover:text-accent"
						href={SOCIAL_LINKS.goodreads}
						target="_blank"
						rel="noopener noreferrer"
					>
						goodreads ↗
					</a>
				</p>
			)
		}
	</header>

	{
		library.length === 0 ? (
			<p class="font-mono text-sm text-muted">The shelves are empty for now. Come back soon.</p>
		) : (
			<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-14">
				<div class="min-w-0">
					<label
						class="reveal mb-10 flex items-center gap-3 border-b border-line pb-3 font-mono text-sm"
						style="--i:4"
					>
						<span class="text-accent" aria-hidden="true">
							❯
						</span>
						<span class="sr-only">Filter books</span>
						<input
							id="library-filter"
							type="search"
							autocomplete="off"
							spellcheck="false"
							placeholder="filter by title, author or subject…"
							class="min-w-0 flex-1 bg-transparent text-ink placeholder:text-muted focus:outline-none"
						/>
						<span
							id="library-count"
							class="shrink-0 text-[0.6875rem] text-muted"
							aria-live="polite"
						/>
					</label>

					<div class="space-y-14">
						{shelves.map((shelf) => (
							<section data-shelf aria-label={`${shelf.shelf} shelf`}>
								<div class="shelf-scroll">
									<ul class="flex items-end gap-[3px] px-3">
										{shelf.books.map((book) => (
											<li class="flex items-end">
												<a
													href={`/library/${book.slug}`}
													class="spine"
													data-spine={book.slug}
													data-search={[book.title, book.author, book.shelf, ...book.subjects].join(
														" "
													)}
													style={[
														`--spine:${book.spine.color}`,
														`--spine-ink:${book.spine.ink}`,
														`--w:${spineWidth(book.highlightCount)}px`,
														`--h:${spineHeight(book.slug)}px`,
														`--i:${spineIndex++}`,
														`view-transition-name:book-${book.slug}`,
													].join(";")}
												>
													<span class="spine-title">{book.title}</span>
													<span class="spine-author" aria-hidden="true">
														{spineAuthor(book.author)}
													</span>
													<span class="sr-only">{book.author ? `, by ${book.author}` : ""}</span>
												</a>
											</li>
										))}
									</ul>
								</div>
								<div class="ledge">
									<span class="plate">{shelf.shelf}</span>
									<span class="plate-count">
										{shelf.books.length} {shelf.books.length === 1 ? "book" : "books"}
									</span>
								</div>
							</section>
						))}
					</div>
				</div>

				<aside class="hidden lg:block" aria-hidden="true">
					<div class="sticky top-28">
						{library.map((book, index) => (
							<article data-preview={book.slug} hidden={index !== 0} class="preview">
								<div class="preview-cover">
									<BookCover book={book} class="rounded-[3px]" />
								</div>
								<h2 class="mt-7 font-serif text-2xl leading-tight text-ink">{book.title}</h2>
								{book.author && <p class="mt-1 font-serif italic text-ink-soft">{book.author}</p>}
								<p class="mt-3 font-mono text-[0.6875rem] text-muted">
									{book.highlightCount} highlights <span class="text-accent">◆</span> highlighted{" "}
									{readingPeriod(book).toLowerCase()}
								</p>
								{book.highlights[0] && (
									<p class="mt-5 border-l-2 border-accent pl-4 font-serif text-[0.95rem] italic leading-relaxed text-ink-soft">
										{snippet(book.highlights[0].text)}
									</p>
								)}
							</article>
						))}
					</div>
				</aside>
			</div>
		)
	}
</PageLayout>

<script>
	const spines = [...document.querySelectorAll<HTMLAnchorElement>("[data-spine]")];
	const previews = new Map(
		[...document.querySelectorAll<HTMLElement>("[data-preview]")].map((node) => [
			node.dataset.preview,
			node,
		])
	);
	let current = previews.values().next().value as HTMLElement | undefined;

	// The pane beside the shelves shows whichever spine the reader is pointing at.
	const show = (slug: string | undefined) => {
		const next = slug ? previews.get(slug) : undefined;
		if (!next || next === current) return;
		if (current) current.hidden = true;
		next.hidden = false;
		current = next;
	};

	for (const spine of spines) {
		spine.addEventListener("pointerenter", () => show(spine.dataset.spine));
		spine.addEventListener("focus", () => show(spine.dataset.spine));
	}

	// Filtering dims the books that don't match instead of removing them, so the
	// shelves keep their shape and the matches stand out where they live.
	const input = document.getElementById("library-filter") as HTMLInputElement | null;
	const count = document.getElementById("library-count");
	const normalize = (value: string) => value.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
	const haystacks = spines.map((spine) => normalize(spine.dataset.search ?? ""));

	input?.addEventListener("input", () => {
		const query = normalize(input.value.trim());
		let matches = 0;
		let first: HTMLAnchorElement | undefined;

		spines.forEach((spine, index) => {
			const match = !query || haystacks[index]!.includes(query);
			spine.toggleAttribute("data-dim", !match);
			spine.tabIndex = match ? 0 : -1;
			if (match) {
				matches++;
				first ??= spine;
			}
		});

		document.querySelectorAll<HTMLElement>("[data-shelf]").forEach((shelf) => {
			shelf.toggleAttribute("data-empty", !shelf.querySelector("[data-spine]:not([data-dim])"));
		});

		if (count) count.textContent = query ? `${matches} of ${spines.length}` : "";
		if (query && first) {
			show(first.dataset.spine);
			first.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
		}
	});
</script>

<style>
	/* Shelves scroll sideways on narrow screens. The top padding leaves room for
	   a book being pulled up on hover. */
	.shelf-scroll {
		overflow-x: auto;
		padding-top: 1.5rem;
		scrollbar-width: none;
		mask-image: linear-gradient(
			90deg,
			transparent,
			#000 0.75rem,
			#000 calc(100% - 1.5rem),
			transparent
		);
	}
	.shelf-scroll::-webkit-scrollbar {
		display: none;
	}

	.spine {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		/* At least as thick as the highlight count says, wider when a long title
		   needs a second or third line. */
		min-width: var(--w);
		height: var(--h);
		padding: 1.25rem 0.375rem 0.75rem;
		border-radius: 3px 3px 1px 1px;
		color: var(--spine-ink);
		/* Shading across the spine makes a flat colour read as a rounded binding. */
		background: linear-gradient(
				90deg,
				rgb(0 0 0 / 0.24),
				rgb(255 255 255 / 0.14) 16%,
				rgb(255 255 255 / 0) 42%,
				rgb(0 0 0 / 0.05) 80%,
				rgb(0 0 0 / 0.3)
			),
			var(--spine);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
		transform-origin: bottom center;
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s ease,
			opacity 0.3s ease, filter 0.3s ease;
		animation: shelve 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
		animation-delay: calc(var(--i) * 22ms + 200ms);
	}

	/* Two gilt bands near the head, like a cloth hardcover. */
	.spine::before,
	.spine::after {
		content: "";
		position: absolute;
		left: 3px;
		right: 3px;
		height: 1px;
		background: currentColor;
		opacity: 0.4;
	}
	.spine::before {
		top: 0.45rem;
	}
	.spine::after {
		top: 0.7rem;
	}

	.spine:hover,
	.spine:focus-visible {
		transform: translateY(-0.9rem);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1), 0 18px 22px -14px rgb(0 0 0 / 0.55);
	}

	.spine:focus-visible {
		outline-offset: 4px;
	}

	/* The last book on a shelf leans on the one before it. */
	li:last-child:not(:first-child) > .spine {
		rotate: 4deg;
		transform-origin: bottom left;
		margin-left: 0.6rem;
	}

	.spine[data-dim] {
		opacity: 0.16;
		filter: grayscale(1);
	}

	.spine-title {
		writing-mode: vertical-rl;
		font-family: var(--font-serif);
		font-size: 0.78125rem;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-wrap: balance;
		/* In vertical writing this caps the line length, so long titles wrap
		   onto another line instead of being cut. */
		max-height: calc(var(--h) - 7rem);
	}

	.spine-author {
		writing-mode: vertical-rl;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.75;
		white-space: nowrap;
	}

	.ledge {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 1.25rem;
		padding: 0 0.75rem;
		border-top: 1px solid var(--theme-line);
		border-radius: 0 0 4px 4px;
		background: linear-gradient(var(--theme-elev), var(--theme-bg));
		box-shadow: 0 12px 18px -14px rgb(0 0 0 / 0.4);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.14em;
		color: var(--theme-muted);
		transition: opacity 0.3s ease;
	}

	.plate {
		color: var(--theme-accent);
	}

	[data-shelf][data-empty] .ledge {
		opacity: 0.35;
	}

	.preview {
		animation: preview-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.preview-cover {
		width: 11rem;
		rotate: -2deg;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.15), 0 18px 30px -16px rgb(0 0 0 / 0.55);
		border-radius: 3px;
	}

	@keyframes shelve {
		from {
			opacity: 0;
			transform: translateY(-1.75rem);
		}
	}

	@keyframes preview-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}
</style>
