---
import type { GetStaticPathsResult } from "astro";
import PageLayout from "@/layouts/Base";
import BookCover from "@/components/library/BookCover";
import { getLibrary, readingPeriod, type LibraryBook } from "@/utils/library";

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
	const library = await getLibrary();
	return library.map((book, index) => ({
		params: { slug: book.slug },
		props: { book, newer: library[index - 1], older: library[index + 1] },
	}));
}

interface Props {
	book: LibraryBook;
	newer?: LibraryBook;
	older?: LibraryBook;
}

const { book, newer, older } = Astro.props;

const meta = {
	title: book.title,
	description: `Passages I highlighted in ${book.title}${
		book.author ? `, by ${book.author}` : ""
	}.`,
};

// Thicker book for more highlights, on the same curve as its spine on the shelf.
const depth = Math.min(46, Math.max(18, Math.round(12 + Math.sqrt(book.highlightCount) * 2.4)));
---

<PageLayout meta={meta} wide>
	<a
		href="/library"
		class="reveal font-mono text-xs text-muted transition-colors hover:text-accent"
		style="--i:0">← the library</a
	>

	<div class="mt-10 grid gap-12 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-16">
		<div>
			<div class="md:sticky md:top-28">
				<div
					class="book3d mx-auto w-44 md:w-full"
					style={`--depth:${depth}px;--spine:${book.spine.color};view-transition-name:book-${book.slug}`}
				>
					<div class="book3d-body">
						<div class="book3d-back" aria-hidden="true"></div>
						<div class="book3d-pages" aria-hidden="true"></div>
						<div class="book3d-cover">
							<BookCover book={book} loading="eager" class="h-full" />
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="min-w-0">
			<p class="reveal eyebrow" style="--i:1">
				<span class="text-accent">//</span> shelf {book.year}
			</p>
			<h1
				class="reveal mt-4 font-serif text-[2.4rem] font-normal leading-[1.08] tracking-tight text-ink sm:text-[3.2rem]"
				style="--i:2"
			>
				{book.title}
			</h1>
			{
				book.author && (
					<p class="reveal mt-3 font-serif text-xl italic text-ink-soft" style="--i:3">
						{book.author}
					</p>
				)
			}
			<p
				class="reveal mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.75rem] text-muted"
				style="--i:4"
			>
				<span>{book.highlightCount} {book.highlightCount === 1 ? "highlight" : "highlights"}</span>
				<span aria-hidden="true" class="text-accent">◆</span>
				<span>read {readingPeriod(book).toLowerCase()}</span>
				<span class="flex items-center gap-x-3">
					<span aria-hidden="true" class="text-accent">◆</span>
					<a
						class="transition-colors hover:text-accent"
						href={book.searchUrl}
						target="_blank"
						rel="noopener noreferrer">find this book ↗</a
					>
				</span>
			</p>

			<section aria-labelledby="passages-heading" class="mt-14">
				<header
					class="reveal flex items-end justify-between gap-4 border-b border-line pb-3"
					style="--i:5"
				>
					<h2 id="passages-heading" class="font-mono text-xs uppercase tracking-[0.16em] text-ink">
						Passages
					</h2>
					<p class="font-mono text-[0.6875rem] text-muted">in reading order</p>
				</header>
				<ol>
					{
						book.highlights.map((highlight, index) => (
							<li
								class="reveal grid grid-cols-[3.25rem_minmax(0,1fr)] gap-x-4 border-b border-dashed border-line py-7 last:border-b-0 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-x-6"
								style={`--i:${Math.min(index, 8) + 6}`}
							>
								<p class="pt-1.5 text-right font-mono text-[0.6875rem] leading-none text-muted">
									<span class="block">
										{highlight.location ?? String(index + 1).padStart(2, "0")}
									</span>
									{highlight.favorite && (
										<span class="mt-2 block text-accent" title="One of my favourites">
											❦
										</span>
									)}
								</p>
								<blockquote class="passage font-serif text-[1.125rem] leading-[1.65] text-ink sm:text-[1.2rem]">
									<p>{highlight.text}</p>
								</blockquote>
							</li>
						))
					}
				</ol>
			</section>
		</div>
	</div>

	{
		(newer || older) && (
			<nav
				aria-label="More books"
				class="mt-24 grid gap-4 border-t border-line pt-8 sm:grid-cols-2"
			>
				{newer ? (
					<a href={`/library/${newer.slug}`} class="neighbour group">
						<div class="w-12 shrink-0 overflow-hidden rounded-[2px] shadow-md">
							<BookCover book={newer} />
						</div>
						<div class="min-w-0">
							<p class="font-mono text-[0.6875rem] text-muted">← read after</p>
							<p class="mt-1 truncate font-serif text-lg text-ink transition-colors group-hover:text-accent">
								{newer.title}
							</p>
						</div>
					</a>
				) : (
					<span />
				)}
				{older && (
					<a
						href={`/library/${older.slug}`}
						class="neighbour group sm:flex-row-reverse sm:text-right"
					>
						<div class="w-12 shrink-0 overflow-hidden rounded-[2px] shadow-md">
							<BookCover book={older} />
						</div>
						<div class="min-w-0">
							<p class="font-mono text-[0.6875rem] text-muted">read before →</p>
							<p class="mt-1 truncate font-serif text-lg text-ink transition-colors group-hover:text-accent">
								{older.title}
							</p>
						</div>
					</a>
				)}
			</nav>
		)
	}
</PageLayout>

<style>
	/* A book you can turn in your hand: front cover, a block of pages on the
	   fore-edge and a back board, set in 3D and angled to show the pages. */
	.book3d {
		perspective: 1400px;
	}

	.book3d-body {
		position: relative;
		aspect-ratio: 2 / 3;
		transform-style: preserve-3d;
		transform: rotateY(-26deg);
		transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
		animation: book-turn 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s backwards;
	}

	.book3d:hover .book3d-body {
		transform: rotateY(-6deg);
	}

	.book3d-cover,
	.book3d-back {
		position: absolute;
		inset: 0;
		border-radius: 2px 5px 5px 2px;
	}

	.book3d-cover {
		overflow: hidden;
		transform: translateZ(calc(var(--depth) / 2));
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
	}

	/* The crease where the cover hinges on the spine. */
	.book3d-cover::after {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgb(255 255 255 / 0.2) 0,
			rgb(0 0 0 / 0.22) 2.2%,
			rgb(255 255 255 / 0.16) 3.6%,
			transparent 8%,
			transparent 92%,
			rgb(0 0 0 / 0.08)
		);
	}

	.book3d-pages {
		position: absolute;
		top: 3px;
		bottom: 3px;
		left: calc(100% - var(--depth) / 2 - 4px);
		width: var(--depth);
		transform: rotateY(90deg);
		background: repeating-linear-gradient(90deg, #f7f0e1 0 1px, #ddd0b6 1px 2px);
		box-shadow: inset 0 0 6px rgb(0 0 0 / 0.15);
	}

	.book3d-back {
		transform: translateZ(calc(var(--depth) / -2));
		background: var(--spine);
		box-shadow: -12px 24px 40px -14px rgb(0 0 0 / 0.55);
	}

	.passage p::before {
		content: "“";
		margin-left: -0.45em;
		color: var(--theme-accent);
	}
	.passage p::after {
		content: "”";
		color: var(--theme-accent);
	}

	.neighbour {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.75rem;
		margin: -0.75rem;
		border-radius: 0.5rem;
		transition: background-color 0.2s ease;
	}
	.neighbour:hover {
		background-color: var(--theme-elev);
	}

	@keyframes book-turn {
		from {
			transform: rotateY(-62deg);
		}
	}
</style>
